model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  password     String   @default("password") @db.VarChar(200)
  isMFAEnabled Boolean  @default(false)
  secretMFA    String?
  profile      Profile?
}
